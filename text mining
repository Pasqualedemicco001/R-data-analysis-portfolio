library(udpipe)
library(readr)
library(dplyr)
library(quanteda)
library(quanteda.textplots)
library(RColorBrewer)
library(ggplot2)
library(tm)

# ------------------------------------------------
# 0. Scarico e carico il modello italiano udpipe
# ------------------------------------------------
ud_model <- udpipe_download_model(language = "italian")
ud_model <- udpipe_load_model(ud_model$file_model)

# ------------------------------------------------
# 1. Imposto la cartella di lavoro
# ------------------------------------------------
setwd("/Users/pasqualedemicco/Desktop/openvar/ytdt_data")

# ------------------------------------------------
# 2. Importo il dataset (Puntata 3)
# ------------------------------------------------
openvarcom <- read_delim("openvarcom3.csv",
                         delim = "\t",
                         escape_double = FALSE,
                         trim_ws = TRUE,
                         show_col_types = FALSE)

# ------------------------------------------------
# 3. Identificazione automatica colonna testo
# ------------------------------------------------
text_col <- grep("text", names(openvarcom), ignore.case = TRUE, value = TRUE)

if (length(text_col) == 0) {
  stop("❌ Nessuna colonna testuale trovata!")
}

openvarcom <- openvarcom %>% rename(text = all_of(text_col))

# ------------------------------------------------
# 4. Rimuovo colonne inutili (solo se esistono)
# ------------------------------------------------
cols_to_remove <- c("replyCount", "likeCount", "publishedAt",
                    "isReply", "isReplyTo", "isReplyToName", "authorName")

openvarcom_clean <- openvarcom %>% select(-all_of(intersect(cols_to_remove, names(openvarcom))))

# ------------------------------------------------
# 5. Pulizia testo
# ------------------------------------------------
openvarcom_clean$text <- gsub("'", " ", openvarcom_clean$text)
openvarcom_clean$text <- gsub("[^\x01-\x7F]", " ", openvarcom_clean$text)
openvarcom_clean$text <- trimws(openvarcom_clean$text)

# ------------------------------------------------
# 6. Lemmatizzazione
# ------------------------------------------------
doc_ids <- as.character(seq_len(nrow(openvarcom_clean)))
annot <- udpipe_annotate(ud_model, x = openvarcom_clean$text, doc_id = doc_ids)
annoi_df <- as.data.frame(annot)

# ------------------------------------------------
# 7. Pulizia UPOS
# ------------------------------------------------
remove_upos <- c("PUNCT","ADP","DET","CCONJ","SCONJ","X","PART","SYM","NUM","INTJ")
annoi_df <- annoi_df %>% 
  filter(!(upos %in% remove_upos)) %>%
  filter(!is.na(lemma), lemma != "")

# Stopwords aggiuntive
extra_stopwords <- c("che","si","io","non","avere","stare","fare",
                     "dire","quello","essere","dovere","cosa","ci","che","si","io","non","avere","stare","fare",
  "dire","quello","essere","dovere","cosa","ci",
  "lo","poi","perch","altro","anche","tutto","solo","chi","il","lo","la","i","gli",
  "le","di","a","da","in","con","l","I","mi","me","mo")

# ------------------------------------------------
# 8. Frequenze lemma
# ------------------------------------------------
lemma_freq <- annoi_df %>%
  filter(!tolower(lemma) %in% extra_stopwords) %>%
  count(lemma, name = "freq") %>%
  arrange(desc(freq))

cat("\n--- Top 20 lemmi ---\n")
print(head(lemma_freq, 20))

# Grafico frequenze lemmi
if (nrow(lemma_freq) > 0) {
  ggplot(head(lemma_freq, 20), aes(x = reorder(lemma, freq), y = freq)) +
    geom_col(fill = "#D55E00") +
    coord_flip() +
    theme_minimal(base_size = 14) +
    labs(title = "Top 20 parole (UDPipe)", x = "Lemma", y = "Frequenza")
} else {
  cat("\n⚠ Nessun lemma disponibile per il grafico.\n")
}

# ------------------------------------------------
# 9. Corpus quanteda
# ------------------------------------------------
texts_by_doc <- annoi_df %>%
  group_by(doc_id) %>%
  summarise(text = paste(lemma, collapse = " "), .groups = "drop")

corp <- corpus(texts_by_doc$text)

# ------------------------------------------------
# 10. Tokenizzazione
# ------------------------------------------------
tokens_clean <- tokens(corp,
                       remove_punct = TRUE,
                       remove_numbers = TRUE) %>%
  tokens_tolower() %>%
  tokens_remove(c(stopwords("italian"), extra_stopwords))

dfm_unigrams <- dfm(tokens_clean)

# ------------------------------------------------
# 11. Grafico frequenze DFM
# ------------------------------------------------
top20 <- topfeatures(dfm_unigrams, 20)

if (length(top20) > 0) {
  df_top <- data.frame(feature = names(top20), freq = as.numeric(top20))
  
  ggplot(df_top, aes(x = reorder(feature, freq), y = freq)) +
    geom_col(fill = "#0072B2") +
    coord_flip() +
    theme_minimal(base_size = 14) +
    labs(title = "Top 20 parole (DFM)", x = "Termine", y = "Frequenza")
} else {
  cat("\n⚠ Nessuna parola nella DFM.\n")
}

# ------------------------------------------------
# 12. Wordcloud
# ------------------------------------------------
if (nfeat(dfm_unigrams) > 0) {
  textplot_wordcloud(dfm_unigrams, max_words = 50,
                     color = brewer.pal(8, "Dark2"))
} else {
  cat("\n⚠ Niente da mostrare nella wordcloud.\n")
}

