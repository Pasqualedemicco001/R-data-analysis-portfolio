process_puntata <- function(file, puntata_nome, stagione_nome) {
  df <- read_delim(
    file, delim = "\t", escape_double = FALSE,
    trim_ws = TRUE, show_col_types = FALSE
  )
  
  text_col <- grep("text", names(df), ignore.case = TRUE, value = TRUE)
  if (length(text_col) == 0) stop("❌ Nessuna colonna testo in ", file)
  
  df <- df %>% rename(text = all_of(text_col))
  
  df$text <- gsub("'", " ", df$text)
  df$text <- gsub("[^\x01-\x7F]", " ", df$text)
  df$text <- trimws(df$text)
  
  df$puntata  <- puntata_nome
  df$stagione <- stagione_nome
  df
