library(udpipe)
library(readr)
library(dplyr)
library(quanteda)
library(quanteda.textplots)
library(RColorBrewer)
library(ggplot2)
library(tm)

# ------------------------------------------------
# 0. Scarico e carico il modello italiano udpipe
# ------------------------------------------------
ud_model <- udpipe_download_model(language = "italian")
ud_model <- udpipe_load_model(ud_model$file_model)

# ------------------------------------------------
# 1. Imposto la cartella di lavoro
# ------------------------------------------------
setwd("/Users/pasqualedemicco/Desktop/openvar/ytdt_data")

# ------------------------------------------------
# 2. Importo il dataset
# ------------------------------------------------
openvarcom <- read_delim("openvarcom.csv", 
                         delim = "\t", 
                         escape_double = FALSE, 
                         trim_ws = TRUE)

# ------------------------------------------------
# 3. Pulizia colonne non necessarie
# ------------------------------------------------
openvarcom_clean <- openvarcom %>%
  select(-replyCount, -likeCount, -publishedAt, 
         -isReply, -isReplyTo, -isReplyToName, -authorName)

# ------------------------------------------------
# 4. Pulizia del testo
# ------------------------------------------------
openvarcom_clean$text <- gsub("'", " ", openvarcom_clean$text)
openvarcom_clean$text <- gsub("[^\x01-\x7F]", " ", openvarcom_clean$text)
openvarcom_clean$text <- trimws(openvarcom_clean$text)

# ------------------------------------------------
# 5. Lemmatizzazione con udpipe
# ------------------------------------------------
doc_ids <- as.character(seq_len(nrow(openvarcom_clean)))
annot <- udpipe_annotate(ud_model, x = openvarcom_clean$text, doc_id = doc_ids)
annoi_df <- as.data.frame(annot)

# ------------------------------------------------
# 6. Pulizia UPOS
# ------------------------------------------------
annoi_df$lemma[is.na(annoi_df$lemma)] <- ""

remove_upos <- c("PUNCT", "ADP", "DET", "CCONJ", "SCONJ",
                 "X", "PART", "SYM", "NUM", "INTJ")

annoi_df <- annoi_df %>%
  filter(!(upos %in% remove_upos)) %>%
  filter(lemma != "")

# ------------------------------------------------
# 6b. Stopwords AGGIORNATE per rimuovere parole dai grafici
# ------------------------------------------------
extra_stopwords <- c(
  "che","si","io","non","avere","stare","fare",
  "dire","quello","essere","dovere","cosa","ci",
  "lo","poi","perch","altro","anche","tutto","solo","chi","il","lo","la","i","gli",
  "le","di","a","da","in","con","l","I","mi","me","mo"
)

# ------------------------------------------------
# 6c. Rimuovo lemmi lunghi (>15 caratteri)
# ------------------------------------------------
annoi_df <- annoi_df %>%
  filter(nchar(lemma) <= 15)

# ------------------------------------------------
# 7. Frequenze lemmi (pulite)
# ------------------------------------------------
lemma_freq <- annoi_df %>%
  filter(!tolower(lemma) %in% extra_stopwords) %>%
  count(lemma, name = "freq") %>%
  arrange(desc(freq))

cat("\n--- Top 20 parole (UDPipe lemma frequency) ---\n")
print(head(lemma_freq, 20))

ggplot(head(lemma_freq, 20),
       aes(x = reorder(lemma, freq), y = freq)) +
  geom_col(fill = "#D55E00") +
  coord_flip() +
  labs(title = "Top 20 parole più frequenti (UDPipe)",
       x = "Lemma", y = "Frequenza") +
  theme_minimal(base_size = 14)

# ------------------------------------------------
# 8. Frequenza parole chiave
# ------------------------------------------------
keywords <- c("rigore", "var", "arbitro")

key_freq <- lemma_freq %>% filter(lemma %in% keywords)

ggplot(key_freq,
       aes(x = reorder(lemma, freq), y = freq)) +
  geom_col(fill = "#0072B2") +
  coord_flip() +
  labs(title = "Frequenza parole chiave",
       x = "Parola", y = "Frequenza") +
  theme_minimal(base_size = 14)

# ------------------------------------------------
# 9. Ricostruisco documenti dai lemmi
# ------------------------------------------------
texts_by_doc <- annoi_df %>%
  group_by(doc_id) %>%
  summarise(text = paste(lemma, collapse = " "), .groups = "drop")

all_docs <- data.frame(doc_id = doc_ids, stringsAsFactors = FALSE)

texts_by_doc <- all_docs %>%
  left_join(texts_by_doc, by = "doc_id") %>%
  mutate(text = ifelse(is.na(text), "", text)) %>%
  arrange(as.integer(doc_id))

# ------------------------------------------------
# 10. Corpus quanteda
# ------------------------------------------------
corp <- corpus(texts_by_doc$text)

# ------------------------------------------------
# 11. Tokenizzazione + pulizia extra
# ------------------------------------------------
tokens_clean <- tokens(corp,
                         remove_punct = TRUE,
                         remove_numbers = TRUE) %>%
  tokens_tolower() %>%
  tokens_remove(c(
    stopwords("italian"),
    extra_stopwords,
    "cose","cosi","mano","mani","fa","più","perchè",
    "parte","parti","calcio","b","poi","gi","perch","cos",
    "x","d","pu","ogni","po","varre","pe","qui","no"
  ))

# ------------------------------------------------
# 12. Creo DFM
# ------------------------------------------------
dfm_unigrams <- dfm(tokens_clean)

cat("\n--- Top 20 parole (DFM unigrammi) ---\n")
print(topfeatures(dfm_unigrams, 20))

# Grafico
top_vec <- topfeatures(dfm_unigrams, 20)

df_top <- data.frame(
  feature = names(top_vec),
  frequency = as.numeric(top_vec),
  stringsAsFactors = FALSE
)

ggplot(df_top,
       aes(x = reorder(feature, frequency), y = frequency)) +
  geom_col(fill = "#0072B2") +
  coord_flip() +
  labs(title = "Top 20 parole più frequenti (DFM)",
       x = NULL, y = "Frequenza") +
  theme_minimal(base_size = 14)

# ------------------------------------------------
# 13. Wordcloud
# ------------------------------------------------
set.seed(123)
textplot_wordcloud(dfm_unigrams,
                   max_words = 50,
                   random_order = FALSE,
                   rotation = 0.25,
                   color = brewer.pal(8, "Dark2"))

# ------------------------------------------------
# 14. Parole associate (findAssocs)
# ------------------------------------------------
dfm_tm <- as.DocumentTermMatrix(dfm_unigrams, weighting = weightTf)

for (kw in keywords) {
  cat("\n--- Parole associate a:", kw, "---\n")
  if (!(kw %in% Terms(dfm_tm))) {
    cat("Parola chiave non presente nel corpus.\n")
  } else {
    assoc <- findAssocs(dfm_tm, kw, corlimit = 0.3)
    print(assoc)
  }
}

