library(udpipe)
library(readr)
library(dplyr)
library(quanteda)
library(quanteda.textplots)
library(RColorBrewer)
library(ggplot2)

setwd("/Users/pasqualedemicco/Desktop/openvar/ytdt_data")

###############################################################
# File delle 5 puntate della stagione 2
###############################################################
files_s2 <- c(
  "openvarcom.csv",
  "openvarcom2.csv",
  "openvarcom3.csv",
  "openvarcom4.csv",
  "openvarcom5.csv"
)

###############################################################
# Funzione di caricamento + pulizia base
###############################################################
load_and_clean <- function(file) {
  df <- read_delim(file, delim = "\t", trim_ws = TRUE, escape_double = FALSE)
  
  # individua colonna testo
  text_col <- grep("text", names(df), value = TRUE, ignore.case = TRUE)
  df <- df %>% rename(text = all_of(text_col))
  
  # pulizia testo
  df$text <- gsub("'", " ", df$text)
  df$text <- gsub("[^\x01-\x7F]", " ", df$text)
  df$text <- trimws(df$text)
  
  return(df$text)
}

###############################################################
# 1) Importo tutti i commenti delle 5 puntate
###############################################################
all_texts <- unlist(lapply(files_s2, load_and_clean))

###############################################################
# 2) Lemmatizzazione unica per la stagione
###############################################################
ud_model <- udpipe_load_model(udpipe_download_model("italian")$file_model)

annot <- udpipe_annotate(ud_model, x = all_texts, doc_id = seq_along(all_texts))
ann_df <- as.data.frame(annot)

###############################################################
# 3) Pulizia UPOS + stopwords
###############################################################
remove_upos <- c("PUNCT","ADP","DET","CCONJ","SCONJ","X","PART","SYM","NUM","INTJ")

extra_stopwords <- c(
  "che","si","io","non","avere","stare","fare","dire","quello","essere",
  "dovere","cosa","ci","lo","poi","perch","altro","anche","tutto","solo","chi",
  "il","lo","la","i","gli","le","di","a","da","in","con","l","mi","me","mo","ti","to"
)

ann_df <- ann_df %>%
  filter(!(upos %in% remove_upos)) %>%
  filter(!tolower(lemma) %in% extra_stopwords) %>%
  filter(!is.na(lemma), lemma != "") %>%
  filter(nchar(lemma) <= 15)

###############################################################
# 4) Corpus unico + DFM
###############################################################
texts_clean <- ann_df %>%
  group_by(doc_id) %>%
  summarise(text = paste(lemma, collapse = " "), .groups = "drop")

corp <- corpus(texts_clean$text)

tokens_clean <- tokens(corp,
                       remove_punct = TRUE,
                       remove_numbers = TRUE) %>%
  tokens_tolower() %>%
  tokens_remove(c(stopwords("italian"), extra_stopwords))

dfm_s2 <- dfm(tokens_clean)

###############################################################
# 5) Wordcloud unica stagione 2
###############################################################
set.seed(123)
textplot_wordcloud(dfm_s2,
                   max_words = 100,
                   random_order = FALSE,
                   rotation = 0.25,
                   color = brewer.pal(8, "Dark2"))

###############################################################
# 6) Grafico TOP 20 parole – Stagione 2
###############################################################
top20_s2 <- topfeatures(dfm_s2, 20)

df_top <- data.frame(
  feature = names(top20_s2),
  freq = as.numeric(top20_s2)
)

ggplot(df_top,
       aes(x = reorder(feature, freq), y = freq)) +
  geom_col(fill = "#0072B2") +
  coord_flip() +
  theme_minimal(base_size = 14) +
  labs(title = "Top 20 parole – Stagione 2",
       x = "Termine", y = "Frequenza")


