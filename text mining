  labs(title = "ACL – Puntate (Stagione 1 vs Stagione 2)",
       x = "Dimensione 1", y = "Dimensione 2")

###############################################################
# TF-IDF (per selezionare parole importanti)
###############################################################
dfm_tfidf <- dfm_tfidf(dfm_raw, scheme_tf = "count", scheme_df = "inverse")

term_scores <- colSums(dfm_tfidf)
top_terms <- names(sort(term_scores, decreasing = TRUE))[1:30]

###############################################################
# COORDINATE PAROLE
###############################################################
coords_words <- as.data.frame(res_ca$col$coord)
colnames(coords_words)[1:2] <- c("Dim1", "Dim2")
