suppressPackageStartupMessages({
  library(readr)
  library(data.table)
  library(dplyr)
  library(udpipe)
  library(quanteda)
  library(quanteda.textplots)
  library(RColorBrewer)
  library(ggplot2)
  library(tm)    # per findAssocs
})

# Imposta la cartella di lavoro
setwd("/Users/pasqualedemicco/Desktop/openvar/ytdt_data")
cat("Working directory:", getwd(), "\n")

# -----------------------------
# Leggi il file in modo robusto
# -----------------------------
file_path <- "openvarcom2.csv"
if (!file.exists(file_path)) {
  stop(paste0("File '", file_path, "' non trovato in ", getwd(), 
              ". Controlla il percorso o sposta il file nella cartella di lavoro."))
}

read_attempt <- NULL

# prova tab
read_attempt <- tryCatch(
  read_delim(file_path, delim = "\t", escape_double = FALSE, trim_ws = TRUE),
  error = function(e) NULL
)

# prova virgola se tab fallisce
if (is.null(read_attempt)) {
  read_attempt <- tryCatch(
    read_delim(file_path, delim = ",", escape_double = FALSE, trim_ws = TRUE),
    error = function(e) NULL
  )
}

# fallback a fread (auto-detect delimiter)
if (is.null(read_attempt)) {
  read_attempt <- tryCatch(
    as.data.frame(fread(file_path, encoding = "UTF-8", data.table = FALSE), stringsAsFactors = FALSE),
    error = function(e) NULL
  )
}

if (is.null(read_attempt)) stop("Impossibile leggere il file con le strategie automatiche. Controlla il CSV.")

openvarcom2_raw <- as.data.frame(read_attempt, stringsAsFactors = FALSE)
cat("Colonne lette dal file:\n")
print(names(openvarcom2_raw))

# -----------------------------
# Normalizza i nomi delle colonne (rimuove BOM / spazi / maiuscole)
# -----------------------------
clean_names <- names(openvarcom2_raw) %>%
  # rimuove BOM se presente
  gsub("\ufeff", "", .) %>%
  trimws() %>%
  tolower() %>%
  gsub("[^[:alnum:]_]+", "_", .)

names(openvarcom2_raw) <- clean_names
cat("Nomi colonne normalizzati:\n")
print(names(openvarcom2_raw))

# -----------------------------
# Trova la colonna di testo (anche se non si chiama esattamente 'text')
# -----------------------------
candidates <- c("text", "message", "comment", "body", "content", "testo")
found <- intersect(names(openvarcom2_raw), candidates)

if (length(found) == 0) {
  idx <- grep("text|messag|comment|body|content|testo", names(openvarcom2_raw), ignore.case = TRUE)
  if (length(idx) == 0) {
    stop(paste0("Nessuna colonna di testo trovata. Colonne disponibili: ", paste(names(openvarcom2_raw), collapse = ", ")))
  } else {
    text_col <- names(openvarcom2_raw)[idx[1]]
    message("Colonna di testo individuata automaticamente: '", text_col, "'. Verrà rinominata in 'text'.")
    names(openvarcom2_raw)[idx[1]] <- "text"
  }
} else {
  text_col <- found[1]
  if (text_col != "text") {
    message("Rinomino la colonna '", text_col, "' in 'text' per coerenza.")
    names(openvarcom2_raw)[names(openvarcom2_raw) == text_col] <- "text"
  } else {
    message("Colonna 'text' trovata correttamente.")
  }
}

# dataframe definitivo
openvarcom2 <- openvarcom2_raw

# -----------------------------
# Rimuovo solo le colonne indesiderate se esistono (nomi già normalizzati)
# -----------------------------
cols_to_remove <- c("replycount", "likecount", "publishedat",
                    "isreply", "isreplyto", "isreplytoname", "authorname")
cols_present <- intersect(names(openvarcom2), cols_to_remove)
if (length(cols_present) > 0) {
  message("Rimuovo colonne presenti: ", paste(cols_present, collapse = ", "))
  openvarcom2 <- openvarcom2 %>% select(-any_of(cols_present))
} else {
  message("Nessuna delle colonne opzionali da rimuovere era presente.")
}

# controllo finale colonna text
if (! "text" %in% names(openvarcom2)) stop("Dopo le normalizzazioni non è stata trovata la colonna 'text'.")

# -----------------------------
# Pulizia testo
# -----------------------------
openvarcom2$text <- gsub("'", " ", openvarcom2$text)
openvarcom2$text <- gsub("[^\x01-\x7F]", " ", openvarcom2$text)
openvarcom2$text <- trimws(openvarcom2$text)

# -----------------------------
# Carico/usa modello UDPIPE (scarica solo la prima volta)
# -----------------------------
# Se hai già il modello scaricato commenta la riga con udpipe_download_model()
ud_model <- udpipe_download_model(language = "italian")
ud_model <- udpipe_load_model(ud_model$file_model)

# -----------------------------
# Lemmatizzazione con udpipe
# -----------------------------
doc_ids <- as.character(seq_len(nrow(openvarcom2)))
annot <- udpipe_annotate(ud_model, x = openvarcom2$text, doc_id = doc_ids)
annoi_df <- as.data.frame(annot, stringsAsFactors = FALSE)

# -----------------------------
# Pulizia UPOS e stopwords extra
# -----------------------------
annoi_df$lemma[is.na(annoi_df$lemma)] <- ""
remove_upos <- c("PUNCT", "ADP", "DET", "CCONJ", "SCONJ", "X", "PART", "SYM", "NUM", "INTJ")
annoi_df <- annoi_df %>% filter(!(upos %in% remove_upos)) %>% filter(lemma != "")

extra_stopwords <- c("che","si","io","non","avere","stare","fare","dire",
                     "quello","essere","dovere","cosa","ci","che","si","io","non","avere","stare","fare",
  "dire","quello","essere","dovere","cosa","ci",
  "lo","poi","perch","altro","anche","tutto","solo","chi","il","lo","la","i","gli",
  "le","di","a","da","in","con","l","I","mi","me","mo")
keywords <- c("rigore","var","arbitro")

# -----------------------------
# Basic frequency stats (UDpipe) - escludo stopwords extra per i grafici
# -----------------------------
lemma_freq <- annoi_df %>%
  filter(!tolower(lemma) %in% extra_stopwords) %>%
  group_by(lemma) %>%
  summarise(freq = n(), .groups = "drop") %>%
  arrange(desc(freq))

cat("\n--- Top 20 parole (UDPipe lemma frequency) ---\n")
print(head(lemma_freq, 20))

# Grafico top 20 parole
top20_lemmas <- head(lemma_freq, 20)
ggplot(top20_lemmas, aes(x = reorder(lemma, freq), y = freq)) +
  geom_col(fill = "#D55E00") +
  coord_flip() +
  labs(title = "Top 20 parole più frequenti (UDPipe)",
       x = "Parola", y = "Frequenza") +
  theme_minimal(base_size = 14)

# Grafico parole chiave
key_freq <- lemma_freq %>% filter(lemma %in% keywords)
if (nrow(key_freq) == 0) {
  message("Nessuna delle parole chiave trovata in lemma_freq (dopo rimozione stopwords extra).")
} else {
  ggplot(key_freq, aes(x = reorder(lemma, freq), y = freq)) +
    geom_col(fill = "#0072B2") +
    coord_flip() +
    labs(title = "Frequenza delle parole chiave",
         x = "Parola chiave", y = "Frequenza") +
    theme_minimal(base_size = 14)
}

# -----------------------------
# Ricostruisco i documenti dai lemmi
# -----------------------------
texts_by_doc <- annoi_df %>%
  group_by(doc_id) %>%
  summarise(text = paste(lemma, collapse = " "), .groups = "drop")

all_docs <- data.frame(doc_id = doc_ids, stringsAsFactors = FALSE)
texts_by_doc <- all_docs %>%
  left_join(texts_by_doc, by = "doc_id") %>%
  mutate(text = ifelse(is.na(text), "", text)) %>%
  arrange(as.integer(doc_id))

# -----------------------------
# Corpus quanteda e tokenizzazione (NON rimuovere keywords)
# -----------------------------
corp <- corpus(texts_by_doc$text)
tokens_clean <- tokens(corp, what = "word", remove_punct = TRUE, remove_numbers = TRUE) %>%
  tokens_tolower() %>%
  tokens_remove(c(stopwords("italian"), extra_stopwords,
                  # altre parole insignificanti da rimuovere (lascia keywords fuori)
                  "cose","cosi","mano","mani","fa","piu","più","perche","perchè",
                  "parte","parti","calcio","b","poi","gi","perch","cos",
                  "x","d","pu","ogni","po","varre","pe","qui","no"))

dfm_unigrams <- dfm(tokens_clean) %>% dfm_trim(min_termfreq = 1)

cat("\n--- Top 20 parole (DFM unigrammi) ---\n")
print(topfeatures(dfm_unigrams, 20))

# -----------------------------
# Grafico DFM top 20
# -----------------------------
top_vec <- topfeatures(dfm_unigrams, 20)
top_terms <- data.frame(feature = names(top_vec), frequency = as.numeric(top_vec), stringsAsFactors = FALSE)

ggplot(top_terms, aes(x = reorder(feature, frequency), y = frequency)) +
  geom_col(fill = "#0072B2") +
  coord_flip() +
  labs(title = "Top 20 parole più frequenti (DFM unigrammi)", x = NULL, y = "Frequenza") +
  theme_minimal(base_size = 14)

# -----------------------------
# Wordcloud
# -----------------------------
set.seed(123)
textplot_wordcloud(dfm_unigrams, max_words = 50, random_order = FALSE, rotation = 0.25, color = brewer.pal(8, "Dark2"))

# -----------------------------
# Parole associate (findAssocs) - convert to tm
# -----------------------------
dfm_tm <- convert(dfm_unigrams, to = "tm")  # DocumentTermMatrix (tm)
for (kw in keywords) {
  cat("\n--- Parole associate a:", kw, "---\n")
  if (!(kw %in% Terms(dfm_tm))) {
    cat("Parola chiave non presente nel corpus.\n")
  } else {
    assoc <- findAssocs(dfm_tm, kw, corlimit = 0.3)
    print(assoc)
  }
}

cat("\nScript completato.\n")

